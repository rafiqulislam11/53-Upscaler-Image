# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# File Limits
MAX_FILE_SIZE_MB=50

# AI Super-Resolution Provider (Optional)
# If left empty, Image Processing Studio automatically uses high-quality local Lanczos3 upscaler
AI_UPSCALE_ENDPOINT=
AI_UPSCALE_API_KEY=
AI_UPSCALE_MODEL=real-esrgan-4x-plus
